---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Divider from "@components/ui/Divider.astro";
import Prose from "@components/ui/Prose.astro";
import { SITE } from "@/site";
import {
  createTranslator,
  createUrlTranslator,
  collectionFilterByLocale,
} from "@/i18n/utils";
import { bookImageAlt } from "@utils/books";
import { excerptFromBody } from "@utils/content";
import Button from "@components/ui/Button.astro";

export async function getStaticPaths() {
  // Enumerate the category routes once from the (locale-filtered) collection.
  const categories = await getCollection(
    "categories",
    collectionFilterByLocale<"categories">("it"),
  );
  return categories.map((category) => ({
    params: { category: category.data.code },
    props: { category },
  }));
}

const { category } = Astro.props;
const tl = createTranslator(Astro.currentLocale);
const url = createUrlTranslator(Astro.currentLocale);

// Books belonging to this category, newest first.
const books = (
  await getCollection(
    "books",
    collectionFilterByLocale<"books">(Astro.currentLocale),
  )
)
  .filter((b) => b.data.category === category.data.code)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

// Optional long-form appendix (e.g. Critica Letteraria's full bibliography),
// linked to from its own /opere/<code>/tutti page rather than shown inline.
const list = (
  await getCollection(
    "categoryLists",
    collectionFilterByLocale<"categoryLists">(Astro.currentLocale),
  )
).find((l) => l.data.category === category.data.code);

const { Content } = await render(category);

const year = (d: string) => d.match(/\d{4}/)?.[0] ?? "";

const title = `${category.data.title} — ${SITE.title}`;
---

<BaseLayout
  title={title}
  description={excerptFromBody(category.body)}
  breadcrumbs={[
    { label: tl("nav.opere"), href: url("opere") },
    { label: category.data.title },
  ]}
>
  <section class="px-6 pt-10 pb-24 lg:px-4">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12">
        <h1
          class="mb-6 font-serif text-4xl font-medium text-foreground md:text-5xl lg:text-6xl"
        >
          {category.data.title}
        </h1>
        <Divider class="mb-8 mx-0!" />
        {
          list && (
            <Button
              variant="cta"
              href={url(`opere/${category.data.code}/tutti`)}
            >
              {tl("category.viewFullList")}
            </Button>
          )
        }
      </div>

      {/* Category body: opens with the description, then any long-form
          content (Poesia intro, Giornalismo & Critica lists). */}
      <Prose class="mb-16">
        <Content />
      </Prose>

      {
        books.length > 0 ? (
          <ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4 lg:gap-8">
            {books.map((book) => (
              <li>
                <a
                  href={url(`opere/${category.data.code}/${book.data.slug}`)}
                  class="group block"
                >
                  <div class="mb-4 flex aspect-3/4 items-center justify-center overflow-hidden border border-border bg-card transition-all duration-300 group-hover:border-primary/40 group-hover:shadow-lg">
                    {book.data.image ? (
                      <Image
                        src={book.data.image}
                        alt={bookImageAlt(book.data, tl)}
                        widths={[200, 400]}
                        sizes="(min-width: 1024px) 20vw, 45vw"
                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    ) : (
                      <span class="p-6 text-center font-serif text-lg italic text-muted-foreground">
                        {book.data.title}
                      </span>
                    )}
                  </div>
                  <h2 class="font-serif text-lg font-medium leading-snug text-foreground transition-colors group-hover:text-primary">
                    {book.data.title}
                  </h2>
                  {year(book.data.date) && (
                    <p class="mt-1 font-body text-sm text-muted-foreground">
                      {year(book.data.date)}
                    </p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="font-body text-muted-foreground">
            {tl("category.booksEmpty")}
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
