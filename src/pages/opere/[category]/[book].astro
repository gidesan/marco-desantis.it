---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Divider from "@components/ui/Divider.astro";
import Prose from "@components/ui/Prose.astro";
import Button from "@components/ui/Button.astro";
import Lightbox from "@components/Lightbox.astro";
import { SITE } from "@/site";
import {
  createTranslator,
  createUrlTranslator,
  collectionFilterByLocale,
  localeMetadata,
} from "@/i18n/utils";
import { defaultLocale, isLocale } from "@/i18n/locales";
import { bookDisplayTitle, bookImageAlt } from "@utils/books";
import IconAward from "@components/icons/IconAward.astro";
import IconCart from "@components/icons/IconCart.astro";

export async function getStaticPaths() {
  const books = await getCollection(
    "books",
    collectionFilterByLocale<"books">("it"),
  );
  return books.map((book) => ({
    params: { category: book.data.category, book: book.data.slug },
    props: { book },
  }));
}

const { book } = Astro.props;
const tl = createTranslator(Astro.currentLocale);
const url = createUrlTranslator(Astro.currentLocale);

// Parent category (for breadcrumb, title, back link).
const category = (
  await getCollection(
    "categories",
    collectionFilterByLocale<"categories">(Astro.currentLocale),
  )
).find((c) => c.data.code === book.data.category);
const categoryTitle = category?.data.title ?? book.data.category;

const { Content } = await render(book);

const currentLocale =
  Astro.currentLocale && isLocale(Astro.currentLocale)
    ? Astro.currentLocale
    : defaultLocale;
const year = book.data.date.match(/\d{4}/)?.[0];

// Book JSON-LD (overrides the default WebPage schema).
const bookSchema = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: bookDisplayTitle(book.data),
  author: { "@type": "Person", name: SITE.author },
  inLanguage: localeMetadata[currentLocale].bcp47,
  genre: categoryTitle,
  ...(year && { datePublished: year }),
  url: new URL(
    url(`opere/${book.data.category}/${book.data.slug}`),
    Astro.site,
  ).href,
};

const lightboxId = `book-cover-${book.data.slug}`;

// Label for the purchase link: the storefront's bare hostname
// ("edizionihelicon.it"), which reads better than a full URL.
const purchaseVendor = book.data.purchaseUrl
  ? new URL(book.data.purchaseUrl).hostname.replace(/^www\./, "")
  : undefined;
---

<BaseLayout
  title={`${bookDisplayTitle(book.data)} — ${SITE.title}`}
  structuredData={bookSchema}
  breadcrumbs={[
    { label: tl("nav.opere"), href: url("opere") },
    { label: categoryTitle, href: url(`opere/${book.data.category}`) },
    { label: book.data.title },
  ]}
>
  <section class="px-6 pt-10 pb-24 lg:px-4">
    <div class="mx-auto max-w-5xl">
      <div
        class:list={[
          book.data.image &&
            "grid gap-10 md:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16",
        ]}
      >
        {
          book.data.image && (
            <div>
              <a
                href={`#${lightboxId}`}
                class="group block overflow-hidden border border-border bg-card transition-all duration-300 hover:border-primary/40 hover:shadow-lg"
                aria-label={tl("book.enlargeCover")}
              >
                <Image
                  src={book.data.image}
                  alt={bookImageAlt(book.data, tl)}
                  widths={[352, 704]}
                  sizes="(min-width: 768px) 22rem, 90vw"
                  loading="eager"
                  fetchpriority="high"
                  class="w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </a>
            </div>
          )
        }

        <div class="min-w-0">
          <h1
            class="mb-3 font-serif text-3xl leading-tight font-medium text-foreground md:text-4xl lg:text-5xl"
          >
            {book.data.title}
            {book.data.translatedTitle && (
              <span class="mt-1 block font-body text-lg leading-tight font-normal italic text-muted-foreground md:text-xl">
                ({book.data.translatedTitle})
              </span>
            )}
          </h1>
          {
            book.data.publisher && book.data.city && (
              <p class="font-body text-sm uppercase tracking-widest text-muted-foreground">
                {book.data.publisher}, {book.data.city}
              </p>
            )
          }
          {
            year && (
              <p class="font-body text-sm uppercase tracking-widest text-muted-foreground">
                {year}
              </p>
            )
          }
          {
            book.data.award && (
              <div class="mt-4 flex items-center gap-2 text-primary">
                <IconAward class="h-4 w-4 shrink-0" strokeWidth={1.5} />
                <p class="font-body text-sm uppercase tracking-widest">
                  {book.data.award}
                </p>
              </div>
            )
          }
          {
            book.data.purchaseUrl && (
              <a
                href={book.data.purchaseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group mt-4 inline-flex items-center gap-2 text-primary transition-colors hover:text-terracotta-light"
              >
                <IconCart class="h-4 w-4 shrink-0" strokeWidth={1.5} />
                <span class="font-body text-sm uppercase tracking-widest group-hover:underline underline-offset-4">
                  {tl("book.purchase", { vendor: purchaseVendor! })}
                </span>
              </a>
            )
          }
          <Divider class="my-8 mx-0!" />

          <Prose>
            <Content />
          </Prose>

          <div class="mt-12">
            <Button variant="cta" href={url(`opere/${book.data.category}`)}>
              {tl("category.backTo", { category: categoryTitle })}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    book.data.image && (
      <Lightbox
        id={lightboxId}
        prevId={lightboxId}
        nextId={lightboxId}
        image={book.data.image}
        alt={bookImageAlt(book.data, tl)}
        caption={bookDisplayTitle(book.data)}
        showNav={false}
      />
    )
  }
</BaseLayout>
