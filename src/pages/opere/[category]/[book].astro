---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Divider from "@components/ui/Divider.astro";
import Prose from "@components/ui/Prose.astro";
import Button from "@components/ui/Button.astro";
import Lightbox from "@components/Lightbox.astro";
import { SITE } from "@/site";
import {
  createTranslator,
  createUrlTranslator,
  collectionFilterByLocale,
  localeMetadata,
} from "@/i18n/utils";
import { defaultLocale, isLocale } from "@/i18n/locales";
import { bookDisplayTitle } from "@utils/books";

export async function getStaticPaths() {
  const books = await getCollection(
    "books",
    collectionFilterByLocale<"books">("it"),
  );
  return books.map((book) => ({
    params: { category: book.data.category, book: book.data.slug },
    props: { book },
  }));
}

const { book } = Astro.props;
const tl = createTranslator(Astro.currentLocale);
const url = createUrlTranslator(Astro.currentLocale);

// Parent category (for breadcrumb, title, back link).
const category = (
  await getCollection(
    "categories",
    collectionFilterByLocale<"categories">(Astro.currentLocale),
  )
).find((c) => c.data.code === book.data.category);
const categoryTitle = category?.data.title ?? book.data.category;

const { Content } = await render(book);

const currentLocale =
  Astro.currentLocale && isLocale(Astro.currentLocale)
    ? Astro.currentLocale
    : defaultLocale;
const year = book.data.date.match(/\d{4}/)?.[0];

// Book JSON-LD (overrides the default WebPage schema).
const bookSchema = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: bookDisplayTitle(book.data),
  author: { "@type": "Person", name: SITE.author },
  inLanguage: localeMetadata[currentLocale].bcp47,
  genre: categoryTitle,
  ...(year && { datePublished: year }),
  url: new URL(
    url(`opere/${book.data.category}/${book.data.slug}`),
    Astro.site,
  ).href,
};

const lightboxId = `book-cover-${book.data.slug}`;
---

<BaseLayout
  title={`${bookDisplayTitle(book.data)} — ${SITE.title}`}
  structuredData={bookSchema}
  breadcrumbs={[
    { label: tl("nav.opere"), href: url("opere") },
    { label: categoryTitle, href: url(`opere/${book.data.category}`) },
    { label: bookDisplayTitle(book.data) },
  ]}
>
  <section class="px-6 pt-10 pb-24">
    <div class="mx-auto max-w-4xl">
      <div
        class:list={[
          book.data.image &&
            "grid gap-10 md:grid-cols-[minmax(0,18rem)_1fr] lg:gap-16",
        ]}
      >
        {
          book.data.image && (
            <div>
              <a
                href={`#${lightboxId}`}
                class="group block overflow-hidden border border-border bg-card transition-all duration-300 hover:border-primary/40 hover:shadow-lg"
                aria-label="Ingrandisci la copertina"
              >
                <Image
                  src={book.data.image}
                  alt={book.data.imageAlt ?? bookDisplayTitle(book.data)}
                  widths={[288, 576]}
                  sizes="(min-width: 768px) 18rem, 90vw"
                  class="w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </a>
            </div>
          )
        }

        <div class="min-w-0">
          <h1
            class="mb-3 font-serif text-3xl font-medium text-foreground md:text-4xl lg:text-5xl"
          >
            {bookDisplayTitle(book.data)}
          </h1>
          {
            year && (
              <p class="font-body text-sm uppercase tracking-widest text-muted-foreground">
                {year}
              </p>
            )
          }
          <Divider class="my-8 mx-0!" />

          <Prose>
            <Content />
          </Prose>

          <div class="mt-12">
            <Button variant="cta" href={url(`opere/${book.data.category}`)}>
              {tl("category.backTo", { category: categoryTitle })}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    book.data.image && (
      <Lightbox
        id={lightboxId}
        prevId={lightboxId}
        nextId={lightboxId}
        image={book.data.image}
        alt={book.data.imageAlt ?? bookDisplayTitle(book.data)}
        caption={bookDisplayTitle(book.data)}
        showNav={false}
      />
    )
  }
</BaseLayout>
