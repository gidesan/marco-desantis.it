---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Eyebrow from "@components/ui/Eyebrow.astro";
import Divider from "@components/ui/Divider.astro";
import IconBadge from "@components/ui/IconBadge.astro";
import IconEnvelope from "@components/icons/IconEnvelope.astro";
import ContactForm from "@components/ui/ContactForm.astro";
import { SITE } from "@/site";

const title = `Contatti — ${SITE.title}`;
const description =
  "Contatta Marco Ignazio de Santis per informazioni sulle opere, collaborazioni editoriali o interviste.";
---

<BaseLayout title={title} description={description}>
  <section class="px-6 pt-32 pb-16">
    <div class="mx-auto max-w-3xl text-center">
      <Eyebrow class="animate-fade-up mb-4">Scrivimi</Eyebrow>
      <h1
        class="animate-fade-up-delay-1 mb-6 font-serif text-4xl font-medium text-foreground md:text-5xl lg:text-6xl"
      >
        Contatti
      </h1>
      <div class="animate-fade-up-delay-2"><Divider /></div>
    </div>
  </section>

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-4xl">
      <div class="grid gap-12 md:grid-cols-2 lg:gap-20">
        <div>
          <h2
            class="mb-6 font-serif text-2xl font-medium text-foreground md:text-3xl"
          >
            Rimaniamo in contatto
          </h2>
          <p class="mb-8 font-body leading-relaxed text-muted-foreground">
            Per informazioni sulle opere, collaborazioni editoriali, interviste o
            qualsiasi altra richiesta, non esitare a contattarmi.
          </p>

          <div class="flex items-center gap-4">
            <IconBadge>
              <IconEnvelope class="h-5 w-5" />
            </IconBadge>
            <div>
              <p
                class="mb-1 font-body text-xs uppercase tracking-widest text-muted-foreground"
              >
                Email
              </p>
              <a
                href={`mailto:${SITE.email}`}
                class="font-body text-foreground transition-colors hover:text-primary"
              >
                {SITE.email}
              </a>
            </div>
          </div>

          <blockquote class="mt-12 border-l-2 border-primary py-4 pl-6">
            <p class="font-serif text-lg italic text-muted-foreground">
              &ldquo;Ogni lettera ricevuta è un dono, ogni parola condivisa è un
              ponte verso nuove comprensioni.&rdquo;
            </p>
          </blockquote>
        </div>

        <div>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
