---
// Labelled form field wrapper. Renders the uppercase label, then its control
// (passed as children).
interface Props {
  label: string;
  for: string;
}
const { label, for: forId } = Astro.props;
---

<div>
  <label
    for={forId}
    class="mb-2 block font-body text-xs tracking-widest uppercase text-muted-foreground"
  >
    {label}
  </label>
  <slot />
</div>
