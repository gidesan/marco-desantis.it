---
import type { HTMLAttributes } from "astro/types";
interface Props extends Omit<HTMLAttributes<"textarea">, "class"> {
  class?: string;
}
const { class: extra = "", rows = 5, ...rest } = Astro.props;
---

<textarea
  rows={rows}
  class:list={[
    "w-full resize-none border border-border bg-card px-4 py-3 font-body text-foreground placeholder:text-muted-foreground transition-colors focus:border-primary focus:outline-none",
    extra,
  ]}
  {...rest}></textarea>
