---
import Field from "@components/ui/Field.astro";
import Input from "@components/ui/Input.astro";
import Textarea from "@components/ui/Textarea.astro";
import Button from "@components/ui/Button.astro";
import IconSend from "@components/icons/IconSend.astro";
import { SITE } from "@/site";
---

<form data-contact-form class="space-y-6" data-email={SITE.email}>
  <Field label="Nome" for="name">
    <Input type="text" id="name" name="name" required placeholder="Il tuo nome" />
  </Field>
  <Field label="Email" for="email">
    <Input
      type="email"
      id="email"
      name="email"
      required
      placeholder="La tua email"
    />
  </Field>
  <Field label="Oggetto" for="subject">
    <Input
      type="text"
      id="subject"
      name="subject"
      required
      placeholder="Oggetto del messaggio"
    />
  </Field>
  <Field label="Messaggio" for="message">
    <Textarea id="message" name="message" required placeholder="Il tuo messaggio" />
  </Field>
  <Button type="submit" variant="primary">
    <span>Invia messaggio</span>
    <IconSend slot="trailing" class="h-4 w-4" />
  </Button>
</form>

<script>
  // Progressive enhancement: serialize the form into a mailto: link (no backend,
  // matching the original site). Falls back to a normal form if JS is disabled.
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const email = form.dataset.email ?? "";
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") ?? "");
      const mail = String(data.get("email") ?? "");
      const subject = String(data.get("subject") ?? "");
      const message = String(data.get("message") ?? "");
      const body = `Nome: ${name}\nEmail: ${mail}\n\n${message}`;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(
        subject,
      )}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
