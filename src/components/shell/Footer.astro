---
import IconEnvelope from "@components/icons/IconEnvelope.astro";
import Divider from "@components/ui/Divider.astro";
import Link from "@components/ui/Link.astro";
import { SITE } from "@/site";
import { createTranslator, createUrlTranslator } from "@/i18n/utils";

const tl = createTranslator(Astro.currentLocale);
const url = createUrlTranslator(Astro.currentLocale);
const year = new Date().getFullYear();

const navLinks = [
  { name: tl("nav.home"), href: url("") },
  { name: tl("nav.biografia"), href: url("biografia") },
  { name: tl("nav.opere"), href: url("opere") },
];
---

<footer class="border-t border-border/50 bg-paper-dark/30 px-6 py-16">
  <div class="mx-auto max-w-5xl">
    <div class="mb-12 grid gap-12 md:grid-cols-3">
      <div>
        <a href={url("")} class="font-serif text-2xl font-medium text-foreground">
          {tl("brand.name")}
        </a>
        <p class="mt-3 font-body text-sm text-muted-foreground">
          {tl("brand.tagline")}
        </p>
      </div>
      <div>
        <h2
          class="mb-4 font-body text-xs uppercase tracking-[0.2em] text-muted-foreground"
        >
          {tl("footer.nav.title")}
        </h2>
        <ul class="space-y-2">
          {navLinks.map((link) => (
            <li><Link href={link.href}>{link.name}</Link></li>
          ))}
        </ul>
      </div>
      <div>
        <h2
          class="mb-4 font-body text-xs uppercase tracking-[0.2em] text-muted-foreground"
        >
          {tl("footer.contact.title")}
        </h2>
        <a
          href={`mailto:${SITE.email}`}
          class="inline-flex items-center gap-2 font-body text-sm text-foreground transition-colors hover:text-primary"
        >
          <IconEnvelope class="h-4 w-4" />
          <span>{SITE.email}</span>
        </a>
      </div>
    </div>
    <Divider class="mb-8" />
    <p class="text-center font-body text-xs text-muted-foreground">
      {tl("footer.copyright", { year })}
    </p>
  </div>
</footer>
